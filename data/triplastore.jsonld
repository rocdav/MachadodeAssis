    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/sapataria-do-campas/23488",
        "@type": "Place",
        "name": "Sapataria do Campas",
        "description": "A sapataria de João Campas funcionou, desde a década de 1840, na rua do Ouvidor, 77. A partir de 1875, passou a funcionar no número 71. Em 1861, vem anunciada no Almanak Laemmert como Campas & Filho. Depois de 1876, não consta mais do Almanak, sendo provável que tenha encerrado suas atividades. Era considerada elegantíssima e figura também na ficção de José de Alencar.",
        "subjectOf": [],
        "geo": {
            "@type": "GeoCoordinates",
            "@id": "https://maps.google.com/?q=-22.9031196,-43.1772228",
            "gn:name": "R. do Ouvidor - Centro, Rio de Janeiro - RJ, Brazil",
            "wgs84_pos:lat": "-22.9031196",
            "wgs84_pos:long": "-43.1772228",
            "gn:featureCode": "SPOT",
            "gn:featureCodeName": "Spot, Building, Farm"
        }
    },
    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/sapucaia/55464",
        "@type": "Place",
        "name": "Sapucaia",
        "description": "O município de Sapucaia, no estado do Rio de Janeiro, é banhado pelo rio Paraíba do Sul. Seu desenvolvimento começou no século XIX, quando houve um grande fluxo de imigrantes para a região, devido à fertilidade do solo para a cultura do café. A implantação da Estrada de Ferro Dom Pedro II impulsionou o desenvolvimento da região.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "O Imortal",
                "genre": "Conto",
                "datePublished": "1882",
                "text": "Estupefação dos ouvintes, que eram dous, o coronel Bertioga, e o tabelião da vila, João Linhares. A vila era na província fluminense; suponhamos Itaboraí ou Sapucaia. Quanto à data, não tenho dúvida em dizer que foi no ano de 1855, uma noite de novembro, escura como breu, quente como um forno, passante de nove horas. Tudo silêncio. O lugar em que os três estavam era a varanda que dava para o terreiro. Um lampião de luz frouxa, pendurado de um prego, sublinhava a escuridão exterior. De quando em quando, gania um seco e áspero vento, mesclando-se ao som monótono de uma cachoeira próxima. Tal era o quadro e o momento, quando o Dr. Leão insistiu nas primeiras palavras da narrativa.",
                "inLanguage": "pt-BR"
            }
        ],
        "geo": {
            "@type": "GeoCoordinates",
            "@id": "http://sws.geonames.org/3448031/",
            "gn:name": "Sapucaia",
            "wgs84_pos:lat": "-29.83333",
            "wgs84_pos:long": "-51.15",
            "gn:featureCode": "PPL",
            "gn:featureCodeName": "populated place"
        }
    },
    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/saquarema/61368",
        "@type": "Place",
        "name": "Saquarema",
        "description": "Saquarema é uma cidade localizada na região dos Lagos, no estado do Rio de Janeiro, cujos primeiros habitantes foram os tamoios. Em março de 1531 chegaram os portugueses e, em 1594, os padres, com o fim de catequizar os nativos da região. Atualmente, é uma cidade eminentemente turística, por causa das suas praias e lagoas.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Quincas Borba",
                "genre": "Romance",
                "datePublished": "1890",
                "text": "- Era filho aqui de Saquarema; era um que não tinha este olho - continuou o major levando o dedo ao olho esquerdo -. Conheci-o muito, se é que é o mesmo; pode ser que seja outro.",
                "inLanguage": "pt-BR"
            }
        ],
        "geo": {
            "@type": "GeoCoordinates",
            "@id": "http://sws.geonames.org/3448011/",
            "gn:name": "Saquarema",
            "wgs84_pos:lat": "-22.89889",
            "wgs84_pos:long": "-42.46985",
            "gn:featureCode": "PPL",
