            "wgs84_pos:long": "-43.1871808",
            "gn:featureCode": "MT",
            "gn:featureCodeName": "Montanha(s)"
        }
    },
    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/valparaiso/61469",
        "@type": "Place",
        "name": "Valparaíso",
        "description": "Valparaíso é uma cidade chilena, capital da província de mesmo nome. É uma cidade portuária, banhada pelo oceano Pacífico. A baía de Valparaíso era a princípio habitada por populações nativas, não havendo uma data oficial de fundação da cidade, mas acredita-se que tenha sido iniciada pelo explorador espanhol Juan de Saavedra em 1536.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Linha Reta e Linha Curva",
                "genre": "Conto",
                "datePublished": "1869",
                "text": "- Em Valparaíso.",
                "inLanguage": "pt-BR",
                "isPartOf": {
                    "@type": "Book",
                    "name": "Contos fluminenses",
                    "@id": "http://dados.literaturabrasileira.ufsc.br/resource/Contos_Fluminenses"
                }
            }
        ],
        "geo": {
