            {
                "@type": "CreativeWork",
                "headline": "Um Quarto de Século",
                "genre": "Conto",
                "datePublished": "1893",
                "text": "Eram quatro horas da tarde. Oliveira e Tomás conversavam à porta da casa do Desmarais, rua do Ouvidor, ano de 1868, quando passou do lado oposto uma senhora, vestida de preto. Oliveira disse a Tomás:",
                "inLanguage": "pt-BR"
            }
        ],
