    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/loja-do-desmarais/44162",
        "@type": "Place",
        "name": "Loja do Desmarais",
        "description": "A loja Desmarais, primeira do gênero a ser inaugurada na rua do Ouvidor, nas primeiras décadas do século XIX, pertencia aos irmãos Desmarais. Tratava-se de uma perfumaria-cabeleireiro, tida como a mais célebre do gênero, no Rio de Janeiro da época.",
        "subjectOf": [
            {
