            "gn:featureCodeName": "airport"
        }
    },
    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/engaddi/59202",
        "@type": "Place",
        "name": "Engaddi",
        "description": "Ein Gedi (ou Engaddi), cujo nome significa \"nascente do cabrito\", é um oásis localizado a oeste do mar Morto, perto de Massada e das cavernas de Qumran. É conhecido pelas suas grutas, nascentes, e pela sua rica diversidade de fauna e flora. As vinhas de Ein Gedi são mencionadas na Bíblia, no Cântico dos cânticos (1:14); \"A minha amada é para mim como um cacho de flores de henna nos vinhedos de Ein Gedi\".",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Como Se Inventaram os Almanaques",
                "genre": "Conto",
                "datePublished": "1890",
                "text": "- As vinhas de Engaddi...",
                "inLanguage": "pt-BR"
            }
        ],
        "geo": {
            "@type": "GeoCoordinates",
