    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/filadelfia/29794",
        "@type": "Place",
        "name": "Filadélfia",
        "description": "Filadélfia é a maior cidade do estado norte-americano de Pensilvânia, no nordeste dos Estados Unidos. É historicamente famosa porque lá foram assinadas a Declaração da Independência e a Constituição do país.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Anedota Pecuniária",
                "genre": "Conto",
                "datePublished": "1884",
                "text": "- Não fui eu que ajuntei - replicou o Reginaldo -; a coleção pertencia ao espólio de um sujeito de Filadélfia. Custou-me uma bagatela: - cinco mil dollars.",
                "inLanguage": "pt-BR",
