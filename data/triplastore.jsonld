            "@id": "http://sws.geonames.org/1264188/",
            "gn:name": "Malabār Coast",
            "wgs84_pos:lat": "11.24306",
            "wgs84_pos:long": "75.88257",
            "gn:featureCode": "CST",
            "gn:featureCodeName": "coast"
        }
