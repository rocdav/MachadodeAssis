    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/marengo/11376",
        "@type": "Place",
        "name": "Marengo",
        "description": "Marengo (na verdade, Bosco Marengo) é uma pequena cidade do norte da Itália, na região do Piemonte.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Quincas Borba",
                "genre": "Romance",
                "datePublished": "1890",
                "text": "- Olha, mandar-te-ei um dos meus coches, novo em folha; é preciso que tua mulher pouse o seu lindo corpo onde ninguém ainda ousou sentar-se. Almofadas de damasco e veludo, arreios de prata e rodas de ouro; os cavalos descendem do próprio cavalo que meu tio montava em Marengo. Adeus, duque de Palha.",
                "inLanguage": "pt-BR"
            }
        ],
