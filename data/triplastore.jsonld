    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/ponta-do-caju/61421",
        "@type": "Place",
        "name": "Ponta do Caju",
        "description": "No fim da praia do Caju, ficava a ponta do Caju, uma porção de terra, bem menor que um cabo, que invadia as águas da baía de Guanabara. A praia do Caju, hoje não mais existente, situava-se no bairro do mesmo nome, ao longo da atual rua Monsenhor Manuel Gomes. Segundo cronistas do Rio antigo, o bairro era belíssimo e suas praias eram de areias branquinhas e água cristalina.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Esaú e Jacó",
                "genre": "Romance",
                "datePublished": "1904",
                "text": "- Ah! Baronesa, para mim já não há mundo que valha um bilhete de passagem. Vi tudo por várias línguas. Agora o mundo começa aqui no cais da Glória ou na rua do Ouvidor e acaba no cemitério de São João Batista. Ouço que há uns mares tenebrosos para os lados da ponta do Caju, mas eu sou um velho incrédulo, como a senhora dizia há pouco, e não aceito essas notícias sem prova cabal e visual, e para ir averiguá-las, falham-me pernas.",
                "inLanguage": "pt-BR"
            }
        ],
        "geo": {
            "@type": "GeoCoordinates",
            "@id": "https://maps.google.com/?q=-22.8791532,-43.2138435",
            "gn:name": "R. Praia do Cajú - Caju, Rio de Janeiro - RJ, 20931-340, Brazil",
            "wgs84_pos:lat": "-22.8791532",
            "wgs84_pos:long": "-43.2138435",
            "gn:featureCode": "T.CAPE",
            "gn:featureCodeName": "Cape"
        }
    },
    {
