            "wgs84_pos:long": "-44.2224407",
            "gn:featureCode": "PPL",
            "gn:featureCodeName": "populated place"
        }
    },
    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/polo-norte/35623",
        "@type": "Place",
        "name": "Polo Norte",
        "description": "“Polo Norte” é o nome que se dá ao ponto extremo norte da Terra. Situa-se no Oceano Glacial Ártico, onde o mar está coberto por uma camada de gelo.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Uma Excursão Milagrosa",
                "genre": "Conto",
                "datePublished": "1866",
                "text": "O mesmo se dá se a viagem for através dos cadáveres das cidades antigas, dos desertos da Arábia, dos gelos do Norte. Tudo chama o espírito, e o educa, e o eleva, e o transforma.",
                "inLanguage": "pt-BR",
