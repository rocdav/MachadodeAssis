        }
    },
    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/trafalgar/61116",
        "@type": "Place",
        "name": "Trafalgar",
        "description": "O cabo Trafalgar, no Oceano Atlântico, fica na província de Cádiz, na costa sudoeste da Espanha.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Um Incêndio",
                "genre": "Conto",
                "datePublished": "1906",
                "text": "- Apostou alguma corrida? Mas a batalha de Trafalgar pode-se ganhar sem braço ou sem perna. Tudo é mandar, não acha?",
                "inLanguage": "pt-BR"
            }
        ],
        "geo": {
