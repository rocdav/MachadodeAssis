            "wgs84_pos:long": "-43.1875816",
            "gn:featureCode": "PPLX",
            "gn:featureCodeName": "section of populated place"
        }
    },
    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/rua-do-espirito-santo/37298",
        "@type": "Place",
        "name": "Rua do Espírito Santo",
        "description": "A rua do Espírito Santo, atual rua Pedro I, fica no Centro do Rio de Janeiro. Começa na praça Tiradentes e termina perto da rua do Senado.",
        "subjectOf": [],
        "geo": {
            "@type": "GeoCoordinates",
            "@id": "https://maps.google.com/?q=-22.9080138,-43.1824742",
            "gn:name": "R. Pedro I - Centro, Rio de Janeiro - RJ, 20060-050, Brazil",
            "wgs84_pos:lat": "-22.9080138",
