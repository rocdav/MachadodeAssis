    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/rio-paraiba-do-sul/61470",
        "@type": "Place",
        "name": "Rio Paraíba do Sul",
        "description": "O rio Paraíba do Sul, que banha os estados de São Paulo, Minas Gerais e Rio de Janeiro, é formado pela confluência dos rios Paraitinga e Paraibuna. Nasce na serra da Bocaina, no estado de São Paulo, e perfaz um total de 1.137 km, desde a nascente até a foz em Atafona (São João da Barra), no Norte fluminense.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Linha Reta e Linha Curva",
                "genre": "Conto",
                "datePublished": "1869",
                "text": "- Ri mesmo como uma pastorinha alegre. E tu, Teócrito, que fazes? Deixas correr os dias como as águas do Paraíba? Feliz criatura!",
                "inLanguage": "pt-BR",
                "isPartOf": {
                    "@type": "Book",
                    "name": "Contos fluminenses",
                    "@id": "http://dados.literaturabrasileira.ufsc.br/resource/Contos_Fluminenses"
                }
            }
        ],
