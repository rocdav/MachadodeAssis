    {
        "@context": "https://schema.org",
        "@id": "https://machadodeassis.net/referencia/teatro-odeon/31249",
        "@type": "Place",
        "name": "Teatro Odéon",
        "description": "O Teatro Odéon é um dos seis teatros nacionais da França. Situa-se na margem esquerda do rio Sena, próximo ao jardim de Luxemburgo. Começou a ser construído em 1779, mas só foi inaugurado em 1782, com o objetivo de abrigar a Comédie Française, que acabou por instalar-se no Palais Royal. Em 1990, o Teatro Odéon foi renomeado, passando a chamar-se Théâtre de l'Europe.",
        "subjectOf": [
            {
                "@type": "CreativeWork",
                "headline": "Mariana",
                "genre": "Conto",
                "datePublished": "1896",
                "text": "Antes de um mês estava em Paris. Não esquecera a comédia do amigo, a cuja primeira representação no Odéon ficara de assistir. Correu a saber dela; tinha caído redondamente.",
                "inLanguage": "pt-BR",
                "isPartOf": {
                    "@type": "Book",
                    "name": "Várias histórias",
                    "@id": "http://dados.literaturabrasileira.ufsc.br/resource/Várias_Histórias"
                }
            }
        ],
        "geo": {
